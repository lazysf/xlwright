<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="toolTab" label="ツール" insertAfterMso="TabHome">
        <group idMso="GroupClipboard"/>
        <group id="g1" label="操作">
          <button id="doneButton" label="完了通知" imageMso="HappyFace" size="large" onAction="Done"/>
          <button id="saveButton" label="保存" imageMso="FileSave" onAction="Done"/>
          <button id="iconButton" label="アイコンだけ" imageMso="Copy" showLabel="false" onAction="Done"/>
          <button id="offButton" label="使えない" imageMso="Paste" enabled="false" onAction="Done"/>
          <button id="hiddenButton" label="隠し" imageMso="Cut" visible="false" onAction="Done"/>
          <separator id="sep1"/>
          <toggleButton id="dynButton" label="状態次第" getEnabled="GetOff" onAction="Done"/>
        </group>
        <group id="g2" label="その他">
          <menu id="menu1" label="メニュー">
            <button id="menuButton" label="項目" onAction="Done"/>
          </menu>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
