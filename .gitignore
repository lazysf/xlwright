# General patterns first. Add patterns specific to this repository at the end.

# OS-generated files
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor temporary files
*.swp
*.swo
*~
*.bak
*.tmp

# Editor and IDE local state
.vscode/
.idea/
.vs/
*.code-workspace

# Office lock files (created while a workbook is open)
~$*

# Node.js dependencies and logs
node_modules/
npm-debug.log*
.npm/

# Logs and local environment
*.log
.env
.env.*

# ---- Specific to this repository ----

# .NET build and test output
**/bin/
**/obj/
**/TestResults/

# Visual Studio user files
*.user
*.suo

# xlwright runtime state and distribution output
.xlwright/
dist/

# rumdl cache
.rumdl_cache/

# Development plugin MCP config, written by scripts/check.ps1
plugins/xlwright-dev/.mcp.json

# Claude Code settings for this machine only
.claude/settings.local.json
